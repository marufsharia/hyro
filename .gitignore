# Dependencies
/vendor/
/node_modules/

# Lock files (keep composer.lock for packages)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs - IMPORTANT: Do NOT ignore /dist/ as it contains pre-built assets for the package
/public/hot
/public/storage

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE files
/.idea/
/.vscode/
/.kiro/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Testing
.phpunit.result.cache
/coverage/
/.phpunit.cache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.backup
*.bak
*.old

# Laravel specific
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
