{
    "name": "marufsharia/hyro-core",
    "description": "Hyro Core - Foundation package with RBAC, ACL, Models, and Contracts",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maruf Sharia",
            "email": "marufsharia@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "ramsey/uuid": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marufsharia\\Hyro\\Core\\": "src/"
        },
        "files": [
            "src/Helpers/hyro_helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marufsharia\\Hyro\\Core\\CoreServiceProvider"
            ],
            "aliases": {
                "Hyro": "Marufsharia\\Hyro\\Core\\Facades\\Hyro"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
