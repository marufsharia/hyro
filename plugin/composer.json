{
    "name": "marufsharia/hyro-plugin",
    "description": "Hyro Plugin - Plugin and Hook system",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maruf Sharia",
            "email": "marufsharia@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "marufsharia/hyro-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Marufsharia\\Hyro\\Plugin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marufsharia\\Hyro\\Plugin\\PluginServiceProvider"
            ],
            "aliases": {
                "HyroPlugin": "Marufsharia\\Hyro\\Plugin\\Facades\\Plugin"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
