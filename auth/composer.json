{
    "name": "marufsharia/hyro-auth",
    "description": "Hyro Auth - Authentication and Authorization package",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maruf Sharia",
            "email": "marufsharia@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "pragmarx/google2fa": "^8.0",
        "marufsharia/hyro-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Marufsharia\\Hyro\\Auth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marufsharia\\Hyro\\Auth\\AuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
