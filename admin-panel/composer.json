{
    "name": "marufsharia/hyro-admin-panel",
    "description": "Hyro Admin Panel - Admin UI and Dashboard",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maruf Sharia",
            "email": "marufsharia@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "livewire/livewire": "^3.7.6",
        "jantinnerezo/livewire-alert": "^3.0",
        "wire-elements/modal": "^2.0",
        "marufsharia/hyro-core": "^1.0",
        "marufsharia/hyro-auth": "^1.0",
        "marufsharia/hyro-plugin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Marufsharia\\Hyro\\AdminPanel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marufsharia\\Hyro\\AdminPanel\\AdminPanelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
